{
  "name": "chrome-extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && ENVIRONMENT=PRODUCTION vite build",
    "build:dev": "tsc -b && ENVIRONMENT=DEVELOPMENT vite build && mv dist-dev/manifest.dev.json dist-dev/manifest.json",
    "build:watch": "tsc -b && vite build -w",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "^5.2.1",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/react-query": "^5.84.2",
    "change-case": "^5.4.4",
    "chroma-js": "^3.1.2",
    "daisyui": "^5.0.50",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.62.0",
    "react-select": "^5.10.2",
    "tailwindcss": "^4.1.12",
    "zod": "^4.0.16"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/chroma-js": "^3.1.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "chrome-types": "^0.1.371",
    "globals": "^16.3.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
