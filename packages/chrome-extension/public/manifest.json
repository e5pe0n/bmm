{
  "name": "bmm",
  "description": "A bookmark manager",
  "version": "0.0.1",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "16": "succulents-svgrepo-com_16.png",
    "32": "succulents-svgrepo-com_32.png",
    "48": "succulents-svgrepo-com_48.png",
    "128": "succulents-svgrepo-com_128.png"
  },
  "permissions": ["tabs", "activeTab"]
}
